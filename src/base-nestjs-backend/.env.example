APP_PORT=8080
NODE_ENV=local
# REQUIRED in production: browsers reject `Allow-Origin: *` with credentials,
# so an unset value would silently break the dashboard. Startup fails instead.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
MONGODB_URI=mongodb://127.0.0.1:27017/projectName-dev
# Fallback language for API messages when the request doesn't specify one
# (via ?lang=, Accept-Language, or x-lang). Bundled translations: en, vi.
FALLBACK_LANGUAGE=en
GCP_STORAGE_BUCKET_NAME=projectName-staging
GCP_STORAGE_PUBLIC_URL=https://storage.googleapis.com
# Shared bearer secrets. GENERATE THESE -- never hand-write them:
#   openssl rand -hex 32
# In production, startup fails on any value under 32 chars or matching a
# hand-written shape (see src/shared/config/validate-secrets.ts). The guards
# fail closed when a value is unset, so leave one blank to disable that surface
# rather than filling in a placeholder.
# Rotate by setting the new value, redeploying, then updating callers.
WEBSITE_AUTH_TOKEN=
INTERNAL_AUTH_TOKEN=
SLACK_CHANNEL_ID=
SLACK_APP_TOKEN=
# Guards GET /api/dev/checklist. DevModule is registered unconditionally, so
# this endpoint exists in production -- treat it as a production secret.
DEV_API_SECRET_KEY=
# JWT signing secret — REQUIRED in production (generate: openssl rand -hex 32).
# Unset in dev falls back to a well-known value; unset in production throws.
JWT_SECRET=
# Seed admin credentials (npm run seed) — REQUIRED in production, or the seeder
# would create a publicly known account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Number of proxies in front of this service — 1 for Cloud Run on its own.
# A HOP COUNT, never `true`: `true` trusts every X-Forwarded-For entry, which
# lets any caller forge the address the rate limiter counts. Re-check when a
# load balancer goes in front — it becomes 2. Defaults to 'loopback' locally.
TRUST_PROXY=1
# Global rate limit (defaults: 60000ms / 500 requests)
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=500
